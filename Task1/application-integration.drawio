0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.216;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="СМС-коды" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="722.5"/><mxPoint x="720" y="287.5"/></Array></mxGeometry></mxCell><mxCell id="c28" value="создаёт депозит, загружает документы" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.82;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="e-mail: запрос ставки и ответ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="обращения по депозитам" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3667;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="СМС о согласованной ставке" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c9"><mxGeometry x="-0.22" relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="265.0"/></Array></mxGeometry></mxCell><mxCell id="c32" value="скрипты звонков (вручную)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="обрабатывает заявки кол-центра, вводит ставку" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.18;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="анализ кредитного риска" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.82;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="ежедневный Excel со ставками,&lt;br&gt;данные о риске клиента" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.57;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="расчёт ставки в Excel,&lt;br&gt;ответ фронт-офису" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.89;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;Проблемы текущей интеграции&lt;/b&gt;&lt;br&gt;• Ставки существуют только в Excel и почте: ни одна система не может отдать их онлайн-каналам.&lt;br&gt;• Согласование ставки — ручная переписка трёх подразделений: 20 минут, для спецставок до часа.&lt;br&gt;• Интернет-банк читает и пишет напрямую в БД АБС — жёсткая связность и нагрузка на перегруженную базу.&lt;br&gt;• Сайт ни с чем не интегрирован и не принимает заявки.&lt;br&gt;• Партнёрский кол-центр получает информацию только вручную.&lt;br&gt;• Ядро интернет-банка и платформа кол-центра зависят от подрядчиков." style="whiteSpace=wrap;html=1;fontSize=12;shape=note;size=14;fillColor=#FFF9E6;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="60" width="540" height="250" as="geometry"/></mxCell><mxCell id="c38" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=40;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="40" height="24" as="geometry"/></mxCell><mxCell id="c39" value="Участник процесса" style="whiteSpace=wrap;html=1;fontSize=12;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="88" y="1157" width="190" height="30" as="geometry"/></mxCell><mxCell id="c40" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="290" y="1160" width="40" height="24" as="geometry"/></mxCell><mxCell id="c41" value="Система банка" style="whiteSpace=wrap;html=1;fontSize=12;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="338" y="1157" width="190" height="30" as="geometry"/></mxCell><mxCell id="c42" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#8A8A8A;strokeColor=#6B6B6B;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="1160" width="40" height="24" as="geometry"/></mxCell><mxCell id="c43" value="Внешняя система" style="whiteSpace=wrap;html=1;fontSize=12;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="588" y="1157" width="190" height="30" as="geometry"/></mxCell><mxCell id="c44" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="790" y="1160" width="40" height="24" as="geometry"/></mxCell><mxCell id="c45" value="Ручной обмен" style="whiteSpace=wrap;html=1;fontSize=12;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="838" y="1157" width="190" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>