<mxfile host="app.diagrams.net"><diagram name="Схема интеграции приложений (as-is)" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Схема интеграции приложений банка «Стандарт» (as-is) с участниками процесса открытия депозита" style="whiteSpace=wrap;html=1;fontSize=12;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Клиент&lt;/b&gt;&lt;br&gt;&lt;i&gt;[участник]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Физическое лицо, в основном старшего возраста. Предпочитает офлайн-обслуживание" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=40;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="180" height="1060" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Сайт&lt;/b&gt;&lt;br&gt;&lt;i&gt;[PHP, React.js]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Только маркетинговая информация" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="220" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Телеком-оператор&lt;/b&gt;&lt;br&gt;&lt;i&gt;[внешняя система]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Доставка СМС" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#8A8A8A;strokeColor=#6B6B6B;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="220" width="220" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Оператор партнёрского кол-центра&lt;/b&gt;&lt;br&gt;&lt;i&gt;[участник, 100 чел.]&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=40;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="380" width="220" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Оператор кол-центра банка&lt;/b&gt;&lt;br&gt;&lt;i&gt;[участник, 200 чел.]&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=40;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="540" width="220" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Интернет-банк&lt;/b&gt;&lt;br&gt;&lt;i&gt;[ASP.NET MVC 4.5, MS SQL]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Платежи, текущие счета" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="700" width="220" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Сотрудник отделения&lt;/b&gt;&lt;br&gt;&lt;i&gt;[участник, фронт-офис, 500 чел.]&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=40;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="860" width="220" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;СМС-шлюз&lt;/b&gt;&lt;br&gt;&lt;i&gt;[система банка]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Поддерживает IT-отдел" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="840" y="220" width="220" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Система партнёрского кол-центра&lt;/b&gt;&lt;br&gt;&lt;i&gt;[внешняя система]&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#8A8A8A;strokeColor=#6B6B6B;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="840" y="380" width="220" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Система кол-центра&lt;/b&gt;&lt;br&gt;&lt;i&gt;[React.js, Spring Boot, PostgreSQL]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Платформа подрядчика" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="840" y="540" width="220" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;АБС&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Delphi-клиент, Oracle PL/SQL]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Учёт операций по счетам и бухгалтерия. Депозиты, заявки из кол-центра, кредитный раздел, отправка СМС.&lt;br&gt;&lt;br&gt;Разрабатывает команда АБС (20 чел.). БД перегружена, масштабируется только вертикально" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="840" y="700" width="300" height="250" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Корпоративная почта и Excel-файлы ставок&lt;/b&gt;&lt;br&gt;&lt;i&gt;[ручной обмен]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Ежедневный файл ставок, запросы ставок по заявкам, данные для специальных ставок" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="840" y="1040" width="1000" height="90" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Бизнес-представители банка&lt;/b&gt;&lt;br&gt;&lt;i&gt;[участник]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Готовят скрипты звонков" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=40;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1300" y="380" width="220" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Менеджер бэк-офиса кредитов&lt;/b&gt;&lt;br&gt;&lt;i&gt;[участник, 50 чел.]&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=40;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1300" y="860" width="220" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Менеджер бэк-офиса депозитов&lt;/b&gt;&lt;br&gt;&lt;i&gt;[участник, 50 чел.]&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=40;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1620" y="700" width="220" height="90" as="geometry"/></mxCell><mxCell id="c17" value="смотрит информацию о продуктах" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.0425;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="СМС" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.1934;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="звонок" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3443;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="звонок: условия депозита" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4953;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="платежи, текущие счета" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fo