<mxfile host="app.diagrams.net"><diagram name="Карта IT-ландшафта (as-is)" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Карта текущего IT-ландшафта банка «Стандарт» (as-is): оргструктура × бизнес-возможности 2-го уровня" style="whiteSpace=wrap;html=1;fontSize=12;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1800" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Оргструктура ↓ &amp;nbsp;/&amp;nbsp; Бизнес-возможности →&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="260" height="86" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Продажи и маркетинг&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#1F58D0;strokeColor=#17409A;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="70" width="900" height="36" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Поддержка операционных процессов&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#1F58D0;strokeColor=#17409A;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1180" y="70" width="900" height="36" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Продажи в сети отделений&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#E8ECF1;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="280" y="106" width="300" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Продажи через кол-центр&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#E8ECF1;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="580" y="106" width="300" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Digital-оповещения клиентов&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#E8ECF1;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="106" width="300" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Обслуживание депозитных процессов&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#E8ECF1;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1180" y="106" width="300" height="50" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Обслуживание кредитных процессов&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#E8ECF1;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1480" y="106" width="300" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Управление договорами&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#E8ECF1;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1780" y="106" width="300" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Управление обслуживанием в сети отделений&lt;/b&gt;&lt;br&gt;фронт-офис, 50 отделений, 500 чел." style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="156" width="260" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;АБС&lt;/b&gt; (Delphi-клиент): приём заявки и создание депозита в отделении" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#D5E8D4;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="156" width="300" height="120" as="geometry"/></mxCell><mxCell id="c13" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="580" y="156" width="300" height="120" as="geometry"/></mxCell><mxCell id="c14" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="880" y="156" width="300" height="120" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;E-mail&lt;/b&gt;: запрос ставки в бэк-офис депозитов и ожидание ответа; клиент ждёт 20–60 минут" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFF2CC;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1180" y="156" width="300" height="120" as="geometry"/></mxCell><mxCell id="c16" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1480" y="156" width="300" height="120" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;АБС&lt;/b&gt;: оформление депозита, загрузка подписанных документов" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#D5E8D4;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1780" y="156" width="300" height="120" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Кол-центр&lt;/b&gt;&lt;br&gt;200 операторов; платформа подрядчика, 5 чел. сопровождения" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="276" width="260" height="120" as="geometry"/></mxCell><mxCell id="c19" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="276" width="300" height="120" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Система кол-центра&lt;/b&gt; (React.js, Spring Boot, PostgreSQL): обращение по депозиту, передача в &lt;b&gt;АБС&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#D5E8D4;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="580" y="276" width="300" height="120" as="geometry"/></mxCell><mxCell id="c21" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="880" y="276" width="300" height="120" as="geometry"/></mxCell><mxCell id="c22" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1180" y="276" width="300" height="120" as="geometry"/></mxCell><mxCell id="c23" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1480" y="276" width="300" height="120" as="geometry"/></mxCell><mxCell id="c24" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1780" y="276" width="300" height="120" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Партнёрский кол-центр&lt;/b&gt;&lt;br&gt;внешняя компания, 100 чел." style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="396" width="260" height="120" as="geometry"/></mxCell><mxCell id="c26" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="396" width="300" height="120" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Система партнёрского кол-центра&lt;/b&gt; (внешняя): звонки по скриптам банка; скрипты передаются вручную" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#E1E1E1;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="580" y="396" width="300" height="120" as="geometry"/></mxCell><mxCell id="c28" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="880" y="396" width="300" height="120" as="geometry"/></mxCell><mxCell id="c29" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1180" y="396" width="300" height="120" as="geometry"/></mxCell><mxCell id="c30" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1480" y="396" width="300" height="120" as="geometry"/></mxCell><mxCell id="c31" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1780" y="396" width="300" height="120" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;IT-отдел (Управление IT)&lt;/b&gt;&lt;br&gt;АБС: 20 чел.; интернет-банк: 10 чел. + 10 чел. подрядчика" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="516" width="260" height="120" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;АБС&lt;/b&gt; (Delphi, Oracle PL/SQL): разработка и сопровождение командой АБС" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#DAE8FC;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="516" width="300" height="120" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Система кол-центра&lt;/b&gt;: сопровождает подрядчик; точечные доработки делают Java-специалисты команды АБС" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#DAE8FC;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="580" y="516" width="300" height="120" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;СМС-шлюз&lt;/b&gt;: поддержка, взаимодействие с телеком-оператором" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#DAE8FC;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="880" y="516" width="300" height="120" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;АБС&lt;/b&gt;: депозитный раздел, обработка заявок кол-центра" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#DAE8FC;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1180" y="516" width="300" height="120" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;АБС&lt;/b&gt;: кредитный раздел" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#DAE8FC;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1480" y="516" width="300" height="120" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;АБС&lt;/b&gt;: учёт депозитов, хранение документов" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#DAE8FC;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1780" y="516" width="300" height="120" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Управление обслуживанием депозитных продуктов&lt;/b&gt;&lt;br&gt;бэк-офис, 50 чел." style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="636" width="260" height="120" as="geometry"/></mxCell><mxCell id="c40" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="636" width="300" height="120" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;АБС&lt;/b&gt;: обработка заявок из кол-центра, предварительное определение ставки" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#D5E8D4;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="580" y="636" width="300" height="120" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;АБС → СМС-шлюз → телеком-оператор&lt;/b&gt;: СМС клиенту о согласованной ставке" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#D5E8D4;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="880" y="636" width="300" height="120" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Excel + e-mail&lt;/b&gt;: ежедневный файл ставок от отдела кредитов, расчёт ставки по заявке, ответ фронт-офису" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFF2CC;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1180" y="636" width="300" height="120" as="geometry"/></mxCell><mxCell id="c44" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1480" y="636" width="300" height="120" as="geometry"/></mxCell><mxCell id="c45" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1780" y="636" width="300" height="120" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Управление обслуживанием кредитных продуктов&lt;/b&gt;&lt;br&gt;бэк-офис, 50 чел." style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="756" width="260" height="120" as="geometry"/></mxCell><mxCell id="c47" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="756" width="300" height="120" as="geometry"/></mxCell><mxCell id="c48" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="580" y="756" width="300" height="120" as="geometry"/></mxCell><mxCell id="c49" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="880" y="756" width="300" height="120" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Excel + e-mail&lt;/b&gt;: ежедневный расчёт ставок от ставки ЦБ и портфеля, рассылка в бэк-офис депозитов; данные для спецставок" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFF2CC;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1180" y="756" width="300" height="120" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;АБС&lt;/b&gt; (кредитный раздел): анализ кредитного риска банка и клиента" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#D5E8D4;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1480" y="756" width="300" height="120" as="geometry"/></mxCell><mxCell id="c52" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1780" y="756" width="300" height="120" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Команда цифровой трансформации розничного бизнеса&lt;/b&gt;&lt;br&gt;10 чел." style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="876" width="260" height="120" as="geometry"/></mxCell><mxCell id="c54" value="Не эксплуатирует системы. Анализирует процессы всех возможностей, формирует требования, целевую архитектуру и дорожную карту трансформации" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#E1D5E7;strokeColor=#666666;fontColor=#000000;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="280" y="876" width="1800" height="120" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Системы вне карты возможностей&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="1011" width="260" height="80" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Сайт&lt;/b&gt; (PHP, React.js): только маркетинговая информация, заявки не принимает, ни с чем не интегрирован" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="1011" width="900" height="80" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;Интернет-банк&lt;/b&gt; (ASP.NET MVC 4.5, MS SQL): только платежи и текущие счета, работает напрямую с БД АБС; в депозитных процессах не участвует" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;fontSize=11;spacing=10;" vertex="1" parent="1"><mxGeometry x="1180" y="1011" width="900" height="80" as="geometry"/></mxCell><mxCell id="c58" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#D5E8D4;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="1116" width="30" height="24" as="geometry"/></mxCell><mxCell id="c59" value="Автоматизировано в системе" style="whiteSpace=wrap;html=1;fontSize=12;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="58" y="1113" width="295" height="30" as="geometry"/></mxCell><mxCell id="c60" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFF2CC;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="360" y="1116" width="30" height="24" as="geometry"/></mxCell><mxCell id="c61" value="Ручной процесс (Excel, e-mail)" style="whiteSpace=wrap;html=1;fontSize=12;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="398" y="1113" width="295" height="30" as="geometry"/></mxCell><mxCell id="c62" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#DAE8FC;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="1116" width="30" height="24" as="geometry"/></mxCell><mxCell id="c63" value="Разработка и сопровождение системы" style="whiteSpace=wrap;html=1;fontSize=12;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="738" y="1113" width="295" height="30" as="geometry"/></mxCell><mxCell id="c64" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#E1E1E1;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1040" y="1116" width="30" height="24" as="geometry"/></mxCell><mxCell id="c65" value="Внешняя система партнёра" style="whiteSpace=wrap;html=1;fontSize=12;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1078" y="1113" width="295" height="30" as="geometry"/></mxCell><mxCell id="c66" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#E1D5E7;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1380" y="1116" width="30" height="24" as="geometry"/></mxCell><mxCell id="c67" value="Управление изменениями" style="whiteSpace=wrap;html=1;fontSize=12;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1418" y="1113" width="295" height="30" as="geometry"/></mxCell><mxCell id="c68" value="" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#F8CECC;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1720" y="1116" width="30" height="24" as="geometry"/></mxCell><mxCell id="c69" value="Онлайн-каналы не поддерживают возможности карты" style="whiteSpace=wrap;html=1;fontSize=12;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1758" y="1113" width="295" height="30" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b&gt;Что мешает сделать депозиты цифровым продуктом:&lt;/b&gt;&lt;br&gt;1) в карте возможностей нет продаж через онлайн-каналы: сайт и интернет-банк не поддерживают ни одну возможность по депозитам;&lt;br&gt;2) «Обслуживание депозитных процессов» держится на Excel и e-mail — ставки не ведутся ни в одной системе, согласование ставки занимает 20–60 минут;&lt;br&gt;3) все автоматизированные возможности замкнуты на АБС, её БД перегружена; 4) платформы кол-центра и интернет-банка зависят от подрядчиков." style="whiteSpace=wrap;html=1;fontSize=12;shape=note;size=14;fillColor=#FFF9E6;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1161" width="2060" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>