@startuml c4-context-deposit-mvp
!include <C4/C4_Context>

LAYOUT_TOP_DOWN()

title Диаграмма контекста (C4, уровень 1). Открытие депозитов онлайн — MVP

Person(client, "Клиент", "Новый или действующий клиент банка. Выбирает депозит и подаёт заявку онлайн")
Person(ccOperator, "Оператор кол-центра", "Перезванивает по заявкам с сайта, консультирует, предлагает условия")
Person(branchEmployee, "Сотрудник отделения", "Фронт-офис. Идентифицирует нового клиента, оформляет депозит и документы")
Person(depositManager, "Менеджер бэк-офиса депозитов", "Ведёт депозитные ставки, обрабатывает заявки и подтверждает ставку")
Person(creditManager, "Менеджер бэк-офиса кредитов", "Ведёт базовые показатели для расчёта ставок, оценивает кредитный риск")

System(site, "Сайт банка", "PHP, React.js. Витрина депозитов с актуальными ставками, форма заявки (Ф. И. О., телефон)")
System(ib, "Интернет-банк", "Монолит ASP.NET MVC + новые сервисы депозитного контура. Ставки, персональные ставки, заявка на депозит с подтверждением по СМС")
System(abs, "АБС", "Delphi, Oracle PL/SQL. Мастер-система ставок, обработка заявок бэк-офисом, открытие и учёт депозитов")
System(cc, "Система кол-центра", "React.js, Java Spring Boot, PostgreSQL. Очередь заявок с сайта на обзвон, обращения клиентов")
System(kafka, "Шина событий", "Apache Kafka. Асинхронный обмен ставками, заявками и статусами между системами")
System(smsGw, "СМС-шлюз", "Шлюз банка для отправки СМС через телеком-оператора")
System_Ext(telecom, "Телеком-оператор", "Внешний оператор, доставляет СМС клиентам")

Rel(client, site, "Смотрит депозиты и ставки, оставляет заявку", "HTTPS / TLS 1.2+")
Rel(client, ib, "Смотрит ставки, подаёт заявку, подтверждает СМС-кодом", "HTTPS / TLS 1.2+")
Rel(site, ib, "Получает ставки, передаёт заявку нового клиента", "REST/JSON, HTTPS")
Rel(ib, kafka, "Публикует заявки; читает ставки и статусы заявок", "Kafka, TLS")
Rel(abs, kafka, "Публикует ставки и статусы заявок; читает заявки", "Kafka, TLS")
Rel(kafka, cc, "Заявки новых клиентов с сайта", "Kafka, TLS")
Rel(cc, abs, "Обращение по депозиту для предварительного расчёта ставки", "существующая интеграция")
Rel(ib, smsGw, "СМС-код подтверждения заявки", "HTTPS")
Rel(abs, smsGw, "СМС о подтверждённой ставке и об открытии депозита", "существующая интеграция")
Rel(smsGw, telecom, "Отправка СМС", "SMPP/HTTPS")
Rel(telecom, client, "СМС")

Rel(ccOperator, cc, "Обрабатывает заявки с сайта, заводит обращения")
Rel(ccOperator, client, "Звонит и рассказывает об условиях", "телефон")
Rel(branchEmployee, abs, "Идентифицирует клиента, открывает депозит, загружает документы", "Delphi-клиент")
Rel(depositManager, abs, "Ведёт депозитные ставки, подтверждает ставку по заявке", "Delphi-клиент")
Rel(creditManager, abs, "Ведёт показатели кредитного риска, согласует спецставки", "Delphi-клиент")

SHOW_LEGEND()
@enduml
